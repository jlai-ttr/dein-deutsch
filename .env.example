# Dein Deutsch — environment variables
# Copy this file to .env.local for local dev, and add the same to Vercel project settings for production.

# === Auth (existing) ===
# Required in production. Used to:
#   1. Verify login password
#   2. Sign session tokens (HMAC-SHA256)
# Generate a strong random value: `openssl rand -hex 32`
DEIN_DEUTSCH_PASSWORD=setme-in-vercel
# Optional override for HMAC secret. If unset, falls back to DEIN_DEUTSCH_PASSWORD.
# Set this to a DIFFERENT random value to isolate password rotation from session validity:
# SESSION_SECRET=setme-in-vercel
SESSION_COOKIE_NAME=dein_session

# === Google Sheets (Layer 14) ===
# Sheet ID from URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1EPUGRPSsvRHvMlREA-UgykfvwCHNMyemBiOplju5u1I

# Service account JSON — paste full contents on a single line, with literal "\n" in private_key
# (Vercel will store this as an encrypted env var)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"dein-deutsch","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"dein-deutsch-sheets@dein-deutsch.iam.gserviceaccount.com",...}

# Optional: secret for /api/cron/refresh-vocab endpoint
CRON_SECRET=setme-in-vercel
